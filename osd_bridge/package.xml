<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schemans="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>osd_bridge</name>
  <version>0.1.0</version>
  <description>FPV OSD overlay on RK3576 HDMI (Betaflight-style) driven by apm_bridge topics; BBoxRect detection boxes via the Pipeline C++ seam</description>
  <maintainer email="tianqiluo@deepglint.com">nick.luo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>mavros_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
